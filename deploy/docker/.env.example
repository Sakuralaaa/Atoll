# Copy to .env next to compose.yaml and edit. docker compose reads it automatically.

# Image tag: "latest" follows stable releases; pin a release such as v0.2.0 for controlled upgrades.
ATOLL_VERSION=latest
# ATOLL_IMAGE=ghcr.io/sakuralaaa/atoll-server

# URL that browsers, the CLI and agents on other servers use to reach this control server.
# With the https profile: https://<ATOLL_DOMAIN>. Without it: your own HTTPS reverse proxy,
# or http://<server-ip>:7300 only on a private network (Tailscale, firewall-limited).
ATOLL_PUBLIC_URL=https://panel.example.com

# Domain Caddy serves (https profile only). Its A/AAAA record must point at this host.
ATOLL_DOMAIN=panel.example.com

# Where the panel port is published on the host. 127.0.0.1 = only Caddy / a local proxy / an
# agent on this same host can reach it. 0.0.0.0 publishes plain HTTP to everyone; only do that
# behind a firewall or on a private network.
ATOLL_BIND=127.0.0.1
ATOLL_PORT=7300

# Network for the containers. Change both together if 172.30.73.0/24 clashes with your LAN.
# ATOLL_SUBNET=172.30.73.0/24
# ATOLL_PROXY_IP=172.30.73.10

ATOLL_LOG_LEVEL=info
TZ=UTC
